DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
NEON_STORAGE_BUCKET=uploads
AWS_ENDPOINT_URL_S3=https://YOUR_NEON_STORAGE_ENDPOINT
AWS_ACCESS_KEY_ID=YOUR_NEON_STORAGE_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_NEON_STORAGE_SECRET_KEY
AWS_REGION=us-east-2
ADMIN_PASSWORD=use-a-long-random-password
ADMIN_SESSION_SECRET=use-a-random-secret-at-least-32-characters-long

